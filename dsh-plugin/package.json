{
  "name": "dsh-stib-planner",
  "version": "0.0.1",
  "description": "STIB Planner for DSH — 拟杆菌 STIB 基因编辑方案生成器。位点决策 / 全基因组脱靶评估 / sgRNA 与引物设计 / 风险提示 / 批量设计。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "stib"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "bacteroides",
    "genome-editing",
    "STIB",
    "CRISPR-transposase"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('lib',{recursive:true,force:true});fs.rmSync('stib',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run stage:python && npm run clean && npm run build",
    "stage:python": "node scripts/stage-python.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "Yucan Hu",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yucan-Hu/stib_planner.git"
  },
  "homepage": "https://github.com/Yucan-Hu/stib_planner#readme",
  "bugs": {
    "url": "https://github.com/Yucan-Hu/stib_planner/issues"
  }
}
